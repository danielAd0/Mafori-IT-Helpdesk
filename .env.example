# Copy this file to .env and fill it in. Never commit .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True on your laptop only. Never True on the live site.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Your local PostgreSQL (see Development setup in the project doc)
DB_NAME=mafori_helpdesk
DB_USER=helpdesk_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432